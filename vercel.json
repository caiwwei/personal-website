{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/projects", "destination": "/projects.html" },
    { "source": "/experience", "destination": "/experience.html" },
    { "source": "/contact", "destination": "/contact.html" }
  ]
}
